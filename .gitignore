# Ignore database files
/database/*.sql

# Ignore sensitive configuration files
/config/dbconfig.php

# Ignore system files
*.log
*.env
*.bak
*.tmp

# Ignore IDE and editor files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore node_modules (if applicable)
node_modules/

# Ignore compiled files
*.class
*.pyc
*.pyo
*.exe
*.dll

# Ignore cache files
cache/
